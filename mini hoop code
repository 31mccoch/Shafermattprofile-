<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shafer's Mini Hoops</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background-color: #ffffff;
      color: #111;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
    }
    header {
      background-color: #ff2c2c;
      color: white;
      width: 100%;
      text-align: center;
      padding: 20px 0;
      font-size: 2rem;
      font-weight: bold;
      letter-spacing: 1px;
    }
    .product-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 40px;
    }
    .product {
      text-align: center;
      margin-bottom: 40px;
    }
    .product img {
      width: 350px;
      height: auto;
      border: 3px solid #d3d3d3;
      border-radius: 10px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
    .price {
      font-size: 1.2rem;
      color: #333;
      margin-top: 10px;
    }
    button {
      background-color: #ff2c2c;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 5px;
      margin-top: 10px;
      cursor: pointer;
      font-size: 1rem;
      transition: 0.3s;
    }
    button:hover {
      background-color: #e02424;
    }
    footer {
      margin-top: 50px;
      padding: 20px;
      background-color: #f5f5f5;
      width: 100%;
      text-align: center;
      color: #666;
    }
  </style>
</head>
<body>
  <header>Shafer's Mini Hoops</header>

  <section class="product-section">
    <div class="product">
      <img src="Screenshot 2025-11-12 110650.png" alt="Mini Hoop">
      <div class="price">Mini Hoop - $35</div>
      <button>Add to Cart</button>
    </div>

    <div class="product">
      <img src="https://upload.wikimedia.org/wikipedia/commons/7/7a/Basketball.png" alt="Mini Ball" width="150">
      <div class="price">Mini Ball - $5</div>
      <button>Add to Cart</button>
    </div>
  </section>

  <footer>
    © 2025 Shafer's Mini Hoops — All handmade with care 🏀
  </footer>
</body>
</html>
